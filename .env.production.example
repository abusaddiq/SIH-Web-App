# SPAK Innovation Hub — PRODUCTION environment template
# Copy to .env and fill REAL values before going live. See docs/12-environment-variables.md.
# NEVER commit the real .env to git.

DJANGO_SECRET_KEY=ZQuY_P01ykCclC1iLCqWcnVfC1R6BysoX-yDr0yMKvpan5hI0HOfFFdYGzIuZyBbfpY
# Security: generate a FRESH key on the server and keep it secret:
#   python3 -c "import secrets;print(secrets.token_urlsafe(50))"
DJANGO_DEBUG=false
# Replace with the real domain(s), comma-separated, no scheme:
DJANGO_ALLOWED_HOSTS=spak.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://spak.example.com
# REQUIRED once DNS + TLS are live, otherwise admin login silently fails over HTTP:
DJANGO_SECURE_SSL=true
DJANGO_HSTS_SECONDS=31536000
DJANGO_TIME_ZONE=Africa/Lagos

DB_NAME=spak_hub
DB_USER=engr
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5433

AI_PROVIDER=rules
AI_API_KEY=
AI_MODEL=

NOTIFICATION_EMAIL_ENABLED=true
DEFAULT_FROM_EMAIL=no-reply@spak.example.com
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@spak.example.com
EMAIL_HOST_PASSWORD=CHANGE_ME
EMAIL_USE_TLS=true

MAX_UPLOAD_SIZE_MB=8